{
  "name": "dsh-mcp-lens",
  "version": "0.1.0-rc.10",
  "description": "Search large MCP catalogs in DeepSeek Harness with two tools, on-demand schemas, and structured results for multi-step workflows",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "mcp-gateway",
    "model-context-protocol",
    "progressive-disclosure",
    "context-optimization",
    "cost-optimization",
    "tool-discovery",
    "tool-routing"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets/mcp-lens-comparison.svg",
    "assets/mcp-lens-comparison.zh-CN.svg",
    "assets/mcp-lens-overview.svg",
    "assets/mcp-lens-overview.zh-CN.svg",
    "npm-shrinkwrap.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    ".github/RELEASE_CHECKLIST.md",
    "SECURITY.md",
    "EULA.md",
    "PRIVACY.md",
    "SUPPORT.md",
    "docs/LIVE_DEEPSEEK_PILOT.md",
    "docs/LIVE_DEEPSEEK_PILOT.zh-CN.md",
    "docs/PRODUCT_TESTS.md",
    "docs/PRODUCT_TESTS.zh-CN.md",
    "docs/product-tests/2026-09-10.json",
    "LICENSE"
  ],
  "author": "dsh-mcp-lens contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labmimors/dsh-mcp-lens.git"
  },
  "homepage": "https://github.com/labmimors/dsh-mcp-lens#readme",
  "bugs": {
    "url": "https://github.com/labmimors/dsh-mcp-lens/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2 || 0.1.2-alpha.1 || 0.1.2-rc.1 || 0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2 || 0.1.2-alpha.1 || 0.1.2-rc.1 || 0.1.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node ./scripts/run-bench.mjs",
    "verify": "node ./scripts/run-verify.mjs",
    "verify:dsh-desktop-alpha": "node ./scripts/verify-dsh-desktop-alpha.mjs",
    "verify:dsh-install": "node ./scripts/verify-dsh-install.mjs",
    "verify:dsh-profile": "node ./scripts/verify-dsh-profile-install.mjs"
  }
}
