{
  "name": "dsh-mcp-lens",
  "version": "0.1.0-rc.2",
  "description": "Cut MCP context and API cost in DeepSeek Harness with two model-facing tools, lazy discovery, and exact-schema calls",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "mcp-gateway",
    "model-context-protocol",
    "progressive-disclosure",
    "context-optimization",
    "cost-optimization",
    "tool-discovery",
    "tool-routing"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tests",
    "benchmark",
    "assets/mcp-lens-comparison.svg",
    "assets/mcp-lens-comparison.zh-CN.svg",
    "npm-shrinkwrap.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/LIVE_DEEPSEEK_PILOT.md",
    "docs/LIVE_DEEPSEEK_PILOT.zh-CN.md",
    "LICENSE",
    "tsconfig.json",
    "tsdown.config.ts"
  ],
  "author": "dsh-mcp-lens contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labmimors/dsh-mcp-lens.git"
  },
  "homepage": "https://github.com/labmimors/dsh-mcp-lens#readme",
  "bugs": {
    "url": "https://github.com/labmimors/dsh-mcp-lens/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx benchmark/run.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  }
}
